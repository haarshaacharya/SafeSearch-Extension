{
  "manifest_version": 3,
  "name": "SafeSearch - Personal Search & Website Blocker",
  "version": "1.3",
  "description": "Block unwanted searches, websites, and specific URLs.",

  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "SafeSearch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "style.css",
        "blocked.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.in/*",
        "*://*.bing.com/*",
        "*://*.youtube.com/*",
        "*://*.yahoo.com/*",
        "*://*.duckduckgo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}