{
  "manifest_version": 3,
  "name": "SafeSearch - Search & Website Blocker",
  "version": "1.3.1",
  "description": "Block unwanted searches, websites, and specific URLs.",

  "browser_specific_settings": {
    "gecko": {
      "id": "{e8b1d923-47a6-4b21-8f5c-7d9a16f240b9}",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SafeSearch",
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "scripts": ["background/background.js"]
  },

  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html",
        "shared/style.css",
        "blocked/blocked.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.in/*",
        "*://*.bing.com/*",
        "*://*.youtube.com/*",
        "*://*.yahoo.com/*",
        "*://*.duckduckgo.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ]
}
