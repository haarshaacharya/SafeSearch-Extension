{
  "manifest_version": 3,
  "name": "SafeSearch - Search & Website Blocker",
  "version": "1.3",
  "description": "Block unwanted searches, websites, and specific URLs.",

  "browser_specific_settings": {
    "gecko": {
      "id": "safesearch-blocker@hareshacharya.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SafeSearch",
    "default_area": "navbar"
  },

  "background": {
    "scripts": ["background/background.js"]
  },

  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html",
        "shared/style.css",
        "blocked/blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.in/*",
        "*://*.bing.com/*",
        "*://*.youtube.com/*",
        "*://*.yahoo.com/*",
        "*://*.duckduckgo.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ]
}
